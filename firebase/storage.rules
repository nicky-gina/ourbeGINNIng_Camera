rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Permits the owner UI to enumerate and purge the entire wedding folder.
    // This is client-side convenience gating, not secure owner authorization.
    match /wedding-photos/{allPaths=**} {
      allow list, delete: if request.auth != null;
    }

    match /wedding-photos/{userId}/{photoId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && (fileName == 'original.jpg' || fileName == 'thumb.jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
